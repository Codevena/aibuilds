node_modules/
.env
.DS_Store
*.log
backups/*.json
# Reviewgate (auto-added; edit reviewgate.config.ts to override)
.reviewgate/audit/
.reviewgate/cassettes/
!.reviewgate/cassettes/golden/
.reviewgate/reports/
.reviewgate/pending.*
.reviewgate/decisions/
.reviewgate/state.json
.reviewgate/research.md
.reviewgate/dirty.flag
.reviewgate/ESCALATION.md
.reviewgate/.lock
.reviewgate/cache/
.reviewgate/brain/proposals/
.reviewgate/brain/snapshots/
# Antigravity CLI (agy) working-tree artifact
.antigravitycli

# Local agent tooling — keep out of git. Committed auto-exec hooks (.claude/settings.json running
# .reviewgate/bin/*) are a supply-chain/RCE footgun; these stay local-only (hooks still run).
.claude/
.reviewgate/
reviewgate.config.ts

# Backup files and local tool caches — never belong in VCS
*.bak
cache/

# Runtime state — server-managed, may contain PII (agent IPs); never commit
data/state.json
data/state.json.tmp
data/moderation.json
data/moderation.json.tmp

# Review-Artefakte der Definition-of-Done-Pipeline — nur lokal
.review/
